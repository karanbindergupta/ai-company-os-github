# AI Company OS — environment template
# Copy to .env and fill in. NEVER commit .env. NEVER paste a real value into chat,
# a document, or an agent prompt: the company's own rules forbid any agent handling a credential.
#
# Nothing here is required to start. The research floor (Exa anonymous tier, Tavily
# keyless tier, native WebSearch/WebFetch) works with no credentials at all.
# Run `python3 scripts/intelligence.py capability` after setting any of these to
# record the OBSERVED status — the OS never treats configuration as capability.

# ---- Research providers (all optional) ----
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- Source control ----
# Fine-grained PAT. Needs Contents + Metadata; add Administration to create repositories.
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---- Model provider (only if you drive the OS outside Claude Code) ----
MODEL_API_KEY=
ANTHROPIC_API_KEY=

# ---- Company database ----
# Defaults to .ai-company/state/company.db. Override only to relocate it.
COMPANY_DATABASE_URL=

# ---- Optional application backend, if the company ever builds one ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
